{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.guild.dev/project-plan/v1",
  "guildSchemaId": "guild.project-plan/v1",
  "title": "Guild Project Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "project",
    "version",
    "updated_at",
    "updated_by",
    "vision",
    "current_focus",
    "milestones",
    "work_items"
  ],
  "properties": {
    "schema": {
      "const": "guild.project-plan/v1"
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "updated_at": {
      "type": "string",
      "format": "date"
    },
    "updated_by": {
      "type": "string",
      "minLength": 1
    },
    "vision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "current_focus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "milestone",
        "objective",
        "status"
      ],
      "properties": {
        "milestone": {
          "type": "string",
          "minLength": 1
        },
        "objective": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "proposed",
            "planned",
            "ready",
            "in_progress",
            "blocked",
            "in_review",
            "completed",
            "cancelled"
          ]
        }
      }
    },
    "milestones": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "status",
          "weight"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "proposed",
              "planned",
              "ready",
              "in_progress",
              "blocked",
              "in_review",
              "completed",
              "cancelled"
            ]
          },
          "weight": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "work_items": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.guild.dev/task/v1"
      },
      "description": "Every work item in the plan, planned or found. A technical_debt item is work a profile found and did not do (GUILD_MASTER_SPEC.md section 8.1); it carries no milestone until the product owner schedules it, and is excluded from milestone progress until then."
    }
  }
}
