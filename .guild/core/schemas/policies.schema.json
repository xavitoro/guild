{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.guild.dev/policies/v1",
  "guildSchemaId": "guild.policies/v1",
  "title": "Guild Policies",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "principles",
    "approval_required"
  ],
  "properties": {
    "schema": {
      "const": "guild.policies/v1"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "principles": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "approval_required": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "human_interaction": {
      "type": "object",
      "additionalProperties": false,
      "description": "How Guild addresses the human, per GUILD_MASTER_SPEC.md section 3.1.",
      "required": [
        "address_profiles_by",
        "approval_request_required_fields"
      ],
      "properties": {
        "address_profiles_by": {
          "type": "string",
          "enum": [
            "alias",
            "canonical_id"
          ],
          "description": "Which of a profile's two names human-facing messages lead with."
        },
        "approval_request_required_fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Fields a Red-tier approval request must state before a human answers it."
        }
      }
    }
  }
}
