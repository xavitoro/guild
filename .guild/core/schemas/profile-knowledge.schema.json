{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.guild.dev/profile-knowledge/v1",
  "guildSchemaId": "guild.profile-knowledge/v1",
  "title": "Guild Profile Knowledge Ledger",
  "description": "One profile's own accumulated knowledge about the areas it owns, appended as it works. Written only by the profile it belongs to. Entries are evidence-backed observations, not private reasoning; a verified entry may later be promoted into canonical project memory by the orchestrator.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "profile",
    "project",
    "version",
    "updated_at",
    "updated_by",
    "owned_areas",
    "entries"
  ],
  "properties": {
    "schema": {
      "const": "guild.profile-knowledge/v1"
    },
    "profile": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
      "description": "Canonical profile id this ledger belongs to. Must match the file name."
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "updated_at": {
      "type": "string",
      "format": "date"
    },
    "updated_by": {
      "type": "string",
      "minLength": 1,
      "description": "Canonical profile id. Must equal `profile`: a profile writes only its own ledger."
    },
    "owned_areas": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Ids of the ownership-map areas this profile has claimed."
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "area",
          "status",
          "statement",
          "evidence",
          "recorded_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^KN-[a-z][a-z0-9]*(-[a-z0-9]+)*-[0-9]{3}$",
            "description": "KN-<owning profile id>-<sequence>, e.g. KN-business-analyst-001. The owner's id is part of the entry id so a misfiled entry is detectable."
          },
          "area": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "verified",
              "unverified",
              "superseded"
            ]
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "learned_from": {
            "type": "string",
            "minLength": 1,
            "description": "Optional. The interaction this came from \u2014 a run id, step id, review, defect or handoff."
          },
          "recorded_at": {
            "type": "string",
            "format": "date"
          },
          "promoted_to": {
            "type": "string",
            "minLength": 1,
            "description": "Optional. Id of the canonical project-memory entry this was consolidated into by the orchestrator."
          }
        }
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "area",
          "question",
          "raised_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^KNQ-[a-z][a-z0-9]*(-[a-z0-9]+)*-[0-9]{3}$"
          },
          "area": {
            "type": "string",
            "minLength": 1
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "blocked_on": {
            "type": "string",
            "minLength": 1,
            "description": "Optional. Canonical profile id, or 'human', whose answer would close this."
          },
          "raised_at": {
            "type": "string",
            "format": "date"
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "answered",
              "withdrawn"
            ]
          },
          "escalated_as": {
            "type": "string",
            "pattern": "^DR-[0-9]{3}$",
            "description": "Optional. Id of the decision request this question was escalated into. A question blocked on the human must end up here \u2014 it may not stay a private note in a ledger."
          },
          "answer": {
            "type": "string",
            "minLength": 1,
            "description": "Optional. The answer that closed this question, so 'answered' is never an unexplained status."
          },
          "answered_at": {
            "type": "string",
            "format": "date"
          }
        }
      }
    }
  }
}
