{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.guild.dev/project-memory/v1",
  "guildSchemaId": "guild.project-memory/v1",
  "title": "Guild Project Memory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "project",
    "version",
    "updated_at",
    "updated_by",
    "entries"
  ],
  "properties": {
    "schema": {
      "const": "guild.project-memory/v1"
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "updated_at": {
      "type": "string",
      "format": "date"
    },
    "updated_by": {
      "type": "string",
      "minLength": 1
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "category",
          "status",
          "statement",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z]+-[0-9]+$"
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "verified",
              "unverified",
              "superseded"
            ]
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        }
      }
    }
  }
}
