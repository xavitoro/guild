{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.guild.dev/workflow/v1",
  "guildSchemaId": "guild.workflow/v1",
  "title": "Guild Workflow",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "name",
    "description",
    "steps",
    "failure_paths",
    "return_paths",
    "escalation_paths"
  ],
  "properties": {
    "schema": {
      "const": "guild.workflow/v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "proposed",
        "planned",
        "ready",
        "in_progress",
        "blocked",
        "in_review",
        "completed",
        "cancelled"
      ]
    },
    "steps": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.guild.dev/workflow-step/v1"
      },
      "minItems": 1
    },
    "failure_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Description of what happens when a step fails."
    },
    "return_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Description of conditions under which the workflow returns to an earlier step."
    },
    "escalation_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Description of when and how the workflow escalates to a human or another profile."
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
