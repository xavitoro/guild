{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.guild.dev/memory-proposal/v1",
  "guildSchemaId": "guild.memory-proposal/v1",
  "title": "Guild Memory Proposal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "category",
    "statement",
    "evidence",
    "proposed_by",
    "proposed_at",
    "status"
  ],
  "properties": {
    "schema": {
      "const": "guild.memory-proposal/v1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string",
      "minLength": 1,
      "description": "e.g. product, architecture, constraint, pattern."
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "description": "Only stable, verified evidence may support a proposal."
    },
    "proposed_by": {
      "type": "string",
      "minLength": 1
    },
    "proposed_at": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "proposed",
        "accepted",
        "rejected"
      ]
    },
    "reviewed_by": {
      "type": "string",
      "description": "Only the DM (workflow-knowledge-orchestrator) consolidates canonical memory."
    }
  }
}
